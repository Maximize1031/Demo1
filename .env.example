# Copy to .env locally. Never commit or paste your key into chat.
OPENAI_API_KEY=
# Choose an API model with hosted shell + structured output support.
OPENAI_MODEL=gpt-6-astra
# Optional locally; REQUIRED (16+ characters) for production.
DEMO_PASSWORD=
APP_ENV=local
DATA_DIR=./data
# Counts review and chat requests, including failed attempts, over 24 hours.
MAX_LIVE_CALLS_PER_DAY=50
